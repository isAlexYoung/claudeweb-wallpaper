{
  "$schema": "https://raw.githubusercontent.com/isAlexYoung/ClaudeWeb/main/doc/plugin-sdk/manifest.schema.json",
  "manifestVersion": 2,
  "minPluginApi": 2,
  "requiredCapabilities": [
    "slots:background",
    "slots:settings",
    "media-ticket",
    "rpc-raw-stream",
    "public-appearance-v1",
    "surface-wallpaper-vars"
  ],
  "name": "claudeweb-wallpaper",
  "displayName": "Wallpaper",
  "version": "1.2.0",
  "description": "Custom static, animated/video, Wallpaper Engine video, per-theme, and login-screen wallpapers with live workspace glassmorphism.",
  "author": "isAlexYoung",
  "icon": "icon.svg",
  "type": "module",
  "slot": "background",
  "slots": [
    "background",
    "settings"
  ],
  "panel": {
    "title": "Wallpaper Studio",
    "mode": "drawer",
    "width": 440
  },
  "publicAppearance": true,
  "entry": "dist/index.js",
  "server": "dist/server.cjs",
  "build": {
    "mode": "prebuilt",
    "integrity": {
      "dist/index.js": "sha256-7ff1c651c77db84b36753478e1e359557870399a8ab39a2e690e98478bf67093",
      "dist/server.cjs": "sha256-ac9a6095e937b986b8b42995438894fbd595f70555c4f4b9b070ab0377d617cd"
    }
  },
  "permissions": [
    "storage",
    "media",
    "public-appearance"
  ]
}
