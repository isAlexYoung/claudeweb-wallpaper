{
  "$schema": "https://raw.githubusercontent.com/isAlexYoung/ClaudeWeb/main/doc/plugin-sdk/manifest.schema.json",
  "manifestVersion": 2,
  "minPluginApi": 2,
  "requiredCapabilities": [
    "slots:background",
    "slots:settings",
    "media-ticket",
    "rpc-raw-stream",
    "public-appearance-v1",
    "surface-wallpaper-vars"
  ],
  "name": "claudeweb-wallpaper",
  "displayName": "Wallpaper",
  "version": "1.1.0",
  "description": "Custom static, animated/video, per-theme, and login-screen wallpapers with live workspace glassmorphism.",
  "author": "isAlexYoung",
  "icon": "icon.svg",
  "type": "module",
  "slot": "background",
  "slots": [
    "background",
    "settings"
  ],
  "panel": {
    "title": "Wallpaper Studio",
    "mode": "drawer",
    "width": 440
  },
  "publicAppearance": true,
  "entry": "dist/index.js",
  "server": "dist/server.cjs",
  "build": {
    "mode": "prebuilt",
    "integrity": {
      "dist/index.js": "sha256-fba007bc5a5076a0edbc164fb8eb68b461d91137aac8704c7a1816a9b9dc1d87",
      "dist/server.cjs": "sha256-36c12c5aed14f0b3963b62f794367189efa8bb4c26f43237427571c8a279a198"
    }
  },
  "permissions": [
    "storage",
    "media",
    "public-appearance"
  ]
}
