{
  "$schema": "https://raw.githubusercontent.com/isAlexYoung/ClaudeWeb/main/doc/plugin-sdk/manifest.schema.json",
  "manifestVersion": 2,
  "minPluginApi": 2,
  "requiredCapabilities": [
    "slots:background",
    "slots:settings",
    "media-ticket",
    "rpc-raw-stream",
    "public-appearance-v1",
    "surface-wallpaper-vars"
  ],
  "name": "claudeweb-wallpaper",
  "displayName": "Wallpaper",
  "version": "1.2.1",
  "description": "Custom static, animated/video, Wallpaper Engine video, per-theme, and login-screen wallpapers with live workspace glassmorphism.",
  "author": "isAlexYoung",
  "icon": "icon.svg",
  "type": "module",
  "slot": "background",
  "slots": [
    "background",
    "settings"
  ],
  "panel": {
    "title": "Wallpaper Studio",
    "mode": "drawer",
    "width": 440
  },
  "publicAppearance": true,
  "entry": "dist/index.js",
  "server": "dist/server.cjs",
  "build": {
    "mode": "prebuilt",
    "integrity": {
      "dist/index.js": "sha256-033305fc5977d4da36a604cc6754ef96a669bdbaab3fbf7484235b59adcfd940",
      "dist/server.cjs": "sha256-8304dee270576a1dec63256bc726c49cd37b53247861a0798412df5a2f1fc872"
    }
  },
  "permissions": [
    "storage",
    "media",
    "public-appearance"
  ]
}
